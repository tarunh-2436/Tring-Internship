# ==========================================
# Terraform
# ==========================================

# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file information
.terraform.tfstate.lock.info

# Terraform CLI config
.terraformrc
terraform.rc

# ==========================================
# Lambda Build Artifacts
# ==========================================

lambda/*.zip

# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*$py.class

# ==========================================
# IDE
# ==========================================

.vscode/
.idea/

# ==========================================
# OS Files
# ==========================================

.DS_Store
Thumbs.db
desktop.ini